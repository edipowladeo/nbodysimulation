      interface to subroutine ivpbs (ido, neq, fcn, x, xend, tol, param,&
     &           y)
      integer    ido, neq
      real       x, xend, tol, param(*), y(*)
      external   fcn
      end

      interface to subroutine i2pbs (ido, n, fcn, x, xend, tol, param,  &
     &           y, r, s, vnorm, wk)
      integer    ido, n
      real       x, xend, tol, param(*), y(*), r(*), s(*), wk(*)
      external   fcn, vnorm
      end

$IF .NOT. DEFINED (IMSL_MATH_COMMON)

      interface to subroutine czadd (a, acc)
      double precision acc(4)
      complex    a
      end

      interface to subroutine czini (z, acc)
      double precision acc(4)
      complex    z
      end

      interface to subroutine czmul (a, b, acc)
      double precision acc(4)
      complex    a, b
      end

      interface to subroutine czsto (acc, z)
      double precision acc(4)
      complex    z
      end

      interface to subroutine sdadd (a, acc)
      real       a
      double precision acc(2)
      end

      interface to subroutine sdini (s, acc)
      real       s
      double precision acc(2)
      end

      interface to subroutine sdmul (a, b, acc)
      real       a, b
      double precision acc(2)
      end

      interface to subroutine sdsto (acc, s)
      real       s
      double precision acc(2)
      end

$ENDIF

$IF .NOT. DEFINED (IMSL_COMMON_SINGLE)

      interface to real function g2df (x0, iopt, m, x, f, wk)
      integer    iopt, m
      real       x0, x(*), f(*), wk(*)
      end

      interface to real function g3df (xx0, iopt, m, xx, f, c)
      integer    iopt, m
      real       xx0, xx(*), f(*), c(*)
      end

      interface to real function g2in (p, iopt, m, x, f, wk)
      integer    iopt, m
      real       p, x(*), f(*), wk(*)
      end

      interface to subroutine shouap (n, sy, k, j, sa, nrh, nch, sh,    &
     &           ldh)
      integer    k, j, nch, ldh
      real       sa, sy(*), sh(ldh,*)
      end

      interface to subroutine shoutr (n, x, k, j, v, beta)
      integer    n, k, j
      real       beta, x(*), v(*)
      end

$ENDIF

$DEFINE IMSL_MATH_SINGLE	! Single-precision MATH/LIBRARY routines

$IF .NOT. DEFINED (IMSL_MATH_COMMON)
$DEFINE IMSL_MATH_COMMON	! MATH/LIBRARY routines common to both
$ENDIF				! single- and double-precision

$IF .NOT. DEFINED (IMSL_COMMON_SINGLE)
$DEFINE IMSL_COMMON_SINGLE	! Single-precision routines common to
$ENDIF				! both MATH/LIBRARY and STAT/LIBRARY

$IF .NOT. DEFINED (IMSL_COMMON)
$DEFINE IMSL_COMMON		! Routines common to both MATH/LIBRARY
$ENDIF				! and STAT/LIBRARY

$ENDIF
