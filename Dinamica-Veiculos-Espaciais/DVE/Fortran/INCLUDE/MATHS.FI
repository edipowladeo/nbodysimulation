!
!     NOTE:  The following rules are followed to maintain compatibility
!            with fixed-form and free-form source:
!            1. All comments must start with '!'
!            2. All code must be within columns 7-72
!            3. For continuation, a '&' is in column 73 of the line to
!               be continued and in column 6 of the continuation line
!

$IF .NOT. DEFINED (IMSL_MATH_SINGLE)

!
!     Chapter 1:  Linear Systems
!

      interface to subroutine lsarg (n, a, lda, b, ipath, x)
      integer    n, lda, ipath
      real       a(lda,*), b(*), x(*)
      end

      interface to subroutine l2arg (n, a, lda, b, ipath, x, fac, ipvt, &
     &           wk)
      integer    n, lda, ipath, ipvt(*)
      real       a(lda,*), b(*), x(*), fac(*), wk(*)
      end

      interface to subroutine lfcrg (n, a, lda, fac, ldfac, ipvt, rcond)
      integer    n, lda, ldfac, ipvt(*)
      real       rcond, a(lda,*), fac(ldfac,*)
      end

      interface to subroutine l2crg (n, a, lda, fac, ldfac, ipvt, rcond,&
     &           z)
      integer    n, lda, ldfac, ipvt(*)
      real       rcond, a(lda,*), fac(ldfac,*), z(*)
      end

      interface to subroutine lfirg (n, a, lda, fac, ldfac, ipvt, b,    &
     &           ipath, x, res)
      integer    n, lda, ldfac, ipath, ipvt(*)
      real       a(lda,*), fac(ldfac,*), b(*), x(*), res(*)
      end

