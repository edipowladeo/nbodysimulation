      interface to subroutine dscrm (ido, nrow, nvar, ncol, x, ldx, ind,&
     &           ifrq, iwt, igrp, ngroup, imth, iprint, prior, ni,      &
     &           xmean, ldxmea, cov, ldcov, coef, ldcoef, iclass, prob, &
     &           ldprob, class, ldclas, d2, ldd2, stat, nrmiss)
      integer    ido, nrow, nvar, ncol, ldx, ifrq, iwt, igrp, ngroup,   &
     &           imth, iprint, ldxmea, ldcov, ldcoef, ldprob, ldclas,   &
     &           ldd2, nrmiss, ind(*), ni(*), iclass(*)
